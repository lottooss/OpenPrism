{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aimlabs.research/schemas/manifest/dataset_manifest.schema.json",
  "title": "AimAgentDatasetManifest",
  "description": "Schema for versioned, session-aware dataset splits and sample indexing",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "dataset_name",
    "version",
    "created_at_utc",
    "license",
    "classes",
    "split_policy",
    "source_sessions",
    "statistics",
    "samples"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F-]{36}$"
    },
    "dataset_name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "created_at_utc": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "split_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "train_ratio",
        "val_ratio",
        "test_ratio",
        "random_seed"
      ],
      "properties": {
        "strategy": {
          "type": "string",
          "enum": ["session_aware", "task_stratified", "temporal_holdout", "custom"]
        },
        "train_ratio": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "val_ratio": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "test_ratio": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "random_seed": {
          "type": "integer"
        }
      }
    },
    "source_sessions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_samples",
        "train_count",
        "val_count",
        "test_count",
        "total_annotations",
        "dataset_sha256"
      ],
      "properties": {
        "total_samples": {
          "type": "integer",
          "minimum": 0
        },
        "train_count": {
          "type": "integer",
          "minimum": 0
        },
        "val_count": {
          "type": "integer",
          "minimum": 0
        },
        "test_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_annotations": {
          "type": "integer",
          "minimum": 0
        },
        "class_distribution": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "dataset_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sample_id",
          "session_id",
          "task_type",
          "visual_profile",
          "split",
          "image_path",
          "image_sha256",
          "label_path",
          "label_sha256",
          "annotation_count",
          "width",
          "height"
        ],
        "properties": {
          "sample_id": {
            "type": "string"
          },
          "session_id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F-]{36}$"
          },
          "task_type": {
            "type": "string"
          },
          "visual_profile": {
            "type": "string"
          },
          "split": {
            "type": "string",
            "enum": ["train", "val", "test"]
          },
          "image_path": {
            "type": "string"
          },
          "image_sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "label_path": {
            "type": "string"
          },
          "label_sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "annotation_count": {
            "type": "integer",
            "minimum": 0
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
