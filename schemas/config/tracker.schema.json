{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aimlabs.research/schemas/config/tracker.schema.json",
  "title": "AimAgentTrackerConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "models",
    "association",
    "max_missed_frames",
    "immediate_confidence",
    "require_second_observation_below",
    "engage_if_uncertainty_within_radius"
  ],
  "properties": {
    "models": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["stationary", "constant_velocity", "constant_acceleration", "coordinated_turn"]
      },
      "minItems": 1,
      "uniqueItems": true,
      "default": ["stationary", "constant_velocity", "constant_acceleration"]
    },
    "association": {
      "type": "string",
      "enum": ["hungarian", "greedy", "nearest_neighbor"],
      "default": "hungarian"
    },
    "max_missed_frames": {
      "type": "integer",
      "minimum": 0,
      "maximum": 60,
      "default": 3
    },
    "immediate_confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "default": 0.85
    },
    "require_second_observation_below": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "default": 0.85
    },
    "engage_if_uncertainty_within_radius": {
      "type": "boolean",
      "default": true
    },
    "process_noise_scale": {
      "type": "number",
      "minimum": 0.0,
      "default": 1.0
    },
    "measurement_noise_scale": {
      "type": "number",
      "minimum": 0.0,
      "default": 1.0
    },
    "gating_threshold_chi2": {
      "type": "number",
      "minimum": 0.0,
      "default": 9.21
    }
  }
}
