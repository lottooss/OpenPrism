{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aimlabs.research/schemas/config/capture.schema.json",
  "title": "AimAgentCaptureConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "backend",
    "fallback",
    "source_width",
    "source_height",
    "pixel_format",
    "buffers",
    "latest_only",
    "stale_after_ms"
  ],
  "properties": {
    "backend": {
      "type": "string",
      "enum": ["dxgi", "wgc", "replay", "null"],
      "default": "dxgi"
    },
    "fallback": {
      "type": "string",
      "enum": ["wgc", "none", "null"],
      "default": "wgc"
    },
    "source_width": {
      "type": "integer",
      "minimum": 320,
      "maximum": 7680,
      "default": 1920
    },
    "source_height": {
      "type": "integer",
      "minimum": 240,
      "maximum": 4320,
      "default": 1080
    },
    "pixel_format": {
      "type": "string",
      "enum": ["bgra8_sdr", "rgba8_sdr", "nv12"],
      "default": "bgra8_sdr"
    },
    "buffers": {
      "type": "integer",
      "minimum": 2,
      "maximum": 16,
      "default": 2
    },
    "latest_only": {
      "type": "boolean",
      "default": true
    },
    "stale_after_ms": {
      "type": "number",
      "minimum": 1.0,
      "maximum": 100.0,
      "default": 12.0
    },
    "display_index": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "allow_cross_adapter_copy": {
      "type": "boolean",
      "default": false
    }
  }
}
