{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aimlabs.research/schemas/config/policy.schema.json",
  "title": "AimAgentPolicyConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plugin",
    "objective",
    "horizon_targets",
    "switch_hysteresis"
  ],
  "properties": {
    "plugin": {
      "type": "string",
      "default": "deterministic_utility"
    },
    "objective": {
      "type": "string",
      "enum": ["raw_score", "min_switch_cost", "nearest_target", "highest_confidence"],
      "default": "raw_score"
    },
    "horizon_targets": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16,
      "default": 3
    },
    "switch_hysteresis": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 10.0,
      "default": 0.08
    },
    "target_lead_time_ms": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 100.0,
      "default": 0.0
    }
  }
}
